# Environment Configuration for Glow & Glam Studio (Demo Template)
# Copy to `.env` or `.env.local` to override defaults

# Optional: Form submission endpoint (e.g. Web3Forms: https://api.web3forms.com/submit or Formspree: https://formspree.io/f/your_form_id)
# If left blank, the website uses instant structured WhatsApp booking dispatch without third-party email dependencies.
VITE_FORM_ENDPOINT=

# Optional: Web3Forms access key if using Web3Forms
VITE_WEB3FORMS_ACCESS_KEY=
